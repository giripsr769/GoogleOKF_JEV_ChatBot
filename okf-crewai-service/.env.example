# --- Secret keys (never commit the real .env) ---
OPENAI_API_KEY=your-openai-key
TYPESAFE_API_KEY=your-typesafe-key

# --- Models ---
OPENAI_MODEL=gpt-6-luna
JEV_MODEL=jev-latest

# --- Database (read-only role; the sample database is created by db/*.sql) ---
DATABASE_URL=postgresql://okf_readonly:okf_readonly@localhost:5433/shop

# --- OKF knowledge bundle ---
OKF_BUNDLE_DIR=okf_bundle
# Build time only (`okf-chat build`): a login that can see every table. The running chatbot never uses it.
ADMIN_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/shop

# --- API ---
CORS_ORIGINS=http://localhost:4200
PIPELINE_TIMEOUT_S=30
OPENAI_TIMEOUT_S=20
JEV_TIMEOUT_S=10

# --- Behaviour ---
NATURAL_ANSWERS=1
ANSWER_MAX_ROWS=30
MAX_RESULT_ROWS=100
STATEMENT_TIMEOUT_MS=3000
SQL_MAX_RETRIES=2
NAVIGATOR_MAX_TABLES=4
